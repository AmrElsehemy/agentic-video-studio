  "pokedexEntries": [
    {
      "game": "Sun",
      "text": "Reminiscent of the Ultra Beasts, this life-form, apparently asleep underground, is thought to have come from another world in ancient times."
    },
    {
      "game": "Moon",
      "text": "Light is apparently the source of its energy. It has an extraordinarily vicious disposition and is constantly firing off laser beams."
    },
    {
      "game": "Ultra Sun",
      "text": "It looks somehow pained as it rages around in search of light, which serves as its energy. It’s apparently from another world."
    },
    {
      "game": "Ultra Moon",
      "text": "Light is the source of its energy. If it isn’t devouring light, impurities build up in it and on it, and Necrozma darkens and stops moving."
    },
    {
      "game": "Sword",
      "text": "It survives by absorbing light. After a long time spent slumbering underground, impurities accumulated within it, causing its body to darken."
    },
    {
      "game": "Shield",
      "text": "It needs light to survive, and it goes on a rampage seeking it out. Its laser beams will cut anything to pieces."
    }
  ],
