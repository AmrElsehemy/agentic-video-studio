  "pokedexEntries": [
    {
      "game": "Red",
      "text": "It accumulates negative ions in the atmosphere to blast out 10000- volt lightning bolts."
    },
    {
      "game": "Yellow",
      "text": "A sensitive POKé MON that easily becomes sad or angry. Every time its mood changes, it charges power."
    },
    {
      "game": "Gold",
      "text": "It concentrates the weak electric charges emitted by its cells and launches wicked lightning bolts."
    },
    {
      "game": "Silver",
      "text": "Every hair on its body starts to stand sharply on end if it becomes charged with electricity."
    },
    {
      "game": "Crystal",
      "text": "The negatively charged ions generated in its fur create a constant sparking noise."
    },
    {
      "game": "Ruby",
      "text": "JOLTEON’s cells generate a low level of electricity. This power is amplified by the static electricity of its fur, enabling the POKéMON to drop thunderbolts. The bristling fur is made of electrically charged needles."
    },
    {
      "game": "Emerald",
      "text": "Its cells generate weak power that is amplified by its fur’s static electricity to drop thunderbolts. The bristling fur is made of electrically charged needles."
    },
    {
      "game": "Firered",
      "text": "If it is angered or startled, the fur all over its body bristles like sharp needles that pierce foes."
    },
    {
      "game": "Leafgreen",
      "text": "It accumulates negative ions in the atmosphere to blast out 10,000-volt lightning bolts."
    },
    {
      "game": "Diamond",
      "text": "It controls 10,000-volt power and can raise all the fur on its body as if it were sharp needles."
    },
    {
      "game": "Platinum",
      "text": "If agitated, it uses electricity to straighten out its fur and launch it in small bunches."
    },
    {
      "game": "Black 2",
      "text": "By storing electricity in its body, it can shoot its bristlelike fur like a barrage of missiles."
    },
    {
      "game": "Sun",
      "text": "They send out electrical charges of about 10,000 volts. Because they are high-strung, it can be difficult to grow close to them."
    },
    {
      "game": "Moon",
      "text": "When its fur stands on end, that’s a sign it’s about to give off a jolt of electricity. Take care, as sometimes lightning strikes next to it, too."
    },
    {
      "game": "Ultra Sun",
      "text": "Its lungs contain an organ that creates electricity. The crackling sound of electricity can be heard when it exhales."
    },
    {
      "game": "Ultra Moon",
      "text": "Its fur stands on end, becoming like needles it fires at enemies. Once they’re weakened, it finishes them off with a 10,000 volt shock."
    },
    {
      "game": "Lets Go Pikachu",
      "text": "A sensitive Pokémon that easily becomes sad or angry. Every time its mood changes, it charges power."
    },
    {
      "game": "Legends Arceus",
      "text": "Bristles its fur into sharp, needlelike points when enraged. One can hear electricity crackle in its breath when it exhales."
    }
  ],
