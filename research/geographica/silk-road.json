      "sources": [
        "wikipedia-silk-road"
      ]
    },
    {
      "id": "samarkand",
      "text": "Samarkand played a major role in the commercial networks of the Silk Road.",
      "tier": "trusted_secondary",
      "sources": [
        "wikipedia-samarkand"
      ]
    },
    {
      "id": "constantinople",
      "text": "The Silk Road linked Constantinople with China.",
