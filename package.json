{
  "name": "agentic-video-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Data-driven, agent-ready vertical video production with Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "assets": "node scripts/generate-audio.mjs",
    "voice": "node scripts/generate-voice.mjs",
    "voice:preflight": "node scripts/preflight-voice.mjs",
    "voice:local": "node scripts/generate-voice.mjs --provider=local",
    "voice:openai": "node scripts/generate-voice.mjs --provider=openai",
    "episode:compile": "node scripts/compile-episode.mjs",
    "episode:new": "node scripts/new-episode.mjs",
    "episode:prepare": "node scripts/prepare-episode.mjs",
    "episode:check": "node scripts/certify-episode.mjs --fast",
    "episode:certify": "node scripts/certify-episode.mjs",
    "drafts:check": "node scripts/check-compiled-drafts.mjs",
    "description": "node scripts/generate-description.mjs",
    "preflight:publish": "node --import tsx scripts/preflight-publish.ts",
    "youtube:auth": "node scripts/youtube-auth.mjs",
    "youtube:upload": "node scripts/youtube-upload.mjs",
    "youtube:schedule": "node scripts/youtube-upload.mjs",
    "video": "node scripts/render.mjs",
    "video:local": "node scripts/render.mjs --voice=local",
    "video:openai": "node scripts/render.mjs --voice=openai",
    "still": "node scripts/render-still.mjs",
    "sheet": "node scripts/contact-sheet.mjs",
    "critic:video": "node scripts/video-critic.mjs",
    "validate": "node scripts/check-compiled-drafts.mjs && node --import tsx scripts/validate.ts && node scripts/engagement-audit.mjs",
    "engagement": "node scripts/engagement-audit.mjs",
    "critic:calibrate": "node scripts/critic-calibrate.mjs",
    "qa": "node scripts/qa.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "frames": "node scripts/frame-check.mjs",
    "geo:prepare": "node scripts/geo-data.mjs",
    "geo:verify": "node scripts/geo-data.mjs --verify",
    "geo:golden": "node scripts/geo-golden.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.526",
    "@remotion/google-fonts": "4.0.526",
    "@remotion/paths": "4.0.526",
    "d3-geo": "3.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.526",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.526",
    "@remotion/renderer": "4.0.526",
    "@types/d3-geo": "3.1.1",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
