{"scenes":[{"id":"database-pressure","actions":[{"do":"camera","focus":["db"],"padding":0.2,"at":0},{"do":"reveal","target":"db","at":{"word":"database"}}],"why":"The database appears as the destination every click might reach."},{"id":"parts-at-the-boundary","actions":[{"do":"camera","focus":["user","cdn","api","redis","db","net"],"padding":0.12,"at":0},{"do":"reveal","target":"user","at":{"word":"Visitor"}},{"do":"reveal","target":"cdn","at":{"word":"CDN"}},{"do":"reveal","target":"api","at":{"word":"Link"}},{"do":"reveal","target":"redis","at":{"word":"Redis"}},{"do":"reveal","target":"net","at":{"word":"Private"}}],"why":"The request’s boundary and private-network components appear in the order the narration introduces them."},{"id":"write-side-parts","actions":[{"do":"camera","focus":["api","queue","warehouse"],"padding":0.12,"at":0},{"do":"highlight","target":"api","at":{"word":"Link"}},{"do":"reveal","target":"queue","at":{"word":"queue"}},{"do":"reveal","target":"warehouse","at":{"word":"warehouse"}}],"why":"The write-side components are added as the narration shifts from new links to click analytics."},{"id":"open-at-the-edge","actions":[{"do":"camera","focus":["user","cdn"],"padding":0.18,"at":0},{"do":"flow","step":"r1","edges":["e-user-cdn"],"at":{"word":"opens"}},{"do":"highlight","target":"cdn","at":{"word":"CDN"}}],"why":"The opening request travels from the Visitor to the edge, which is shown checking it."},{"id":"forward-on-miss","actions":[{"do":"camera","focus":["cdn","api","net"],"padding":0.14,"at":0},{"do":"flow","step":"r2","edges":["e-cdn-api"],"at":{"word":"miss"}},{"do":"highlight","target":"cdn","at":{"word":"edge","nth":2}},{"do":"highlight","target":"api","at":{"word":"API"}}],"why":"An edge miss is followed by the CDN forwarding the request into the private Link API."},{"id":"lookup-and-fallback","actions":[{"do":"camera","focus":["api","redis","db"],"padding":0.14,"at":0},{"do":"flow","step":"r3","edges":["e-api-redis"],"at":{"word":"looks"}},{"do":"highlight","target":"redis","at":{"word":"Redis"}},{"do":"flow","step":"r4","edges":["e-api-db-read"],"at":{"word":"miss"}},{"do":"highlight","target":"db","at":{"word":"Postgres"}}],"why":"The read first travels to Redis and then falls back to Postgres when the cache misses."},{"id":"save-new-link","actions":[{"do":"camera","focus":["api","db"],"padding":0.18,"at":0},{"do":"flow","step":"w1","edges":["e-api-db-write"],"at":{"word":"saves"}},{"do":"highlight","target":"db","at":{"word":"Postgres"}}],"why":"A new link is shown being saved from the Link API into Postgres."},{"id":"log-the-click","actions":[{"do":"camera","focus":["api","queue"],"padding":0.16,"at":0},{"do":"flow","step":"w2","edges":["e-api-queue"],"at":{"word":"logs"}},{"do":"highlight","target":"queue","at":{"word":"Click"}}],"why":"The click log travels from the API into the queue, separating it from lookup work."},{"id":"batch-to-warehouse","actions":[{"do":"camera","focus":["queue","warehouse"],"padding":0.16,"at":0},{"do":"flow","step":"w3","edges":["e-queue-wh"],"at":{"word":"batches"}},{"do":"highlight","target":"warehouse","at":{"word":"warehouse"}}],"why":"Queued click records are shown becoming batched analytics data in the warehouse."},{"id":"separate-the-paths","actions":[{"do":"camera","focus":"all","padding":0.08,"at":0},{"do":"highlight","target":"redis","at":{"word":"lookup"}},{"do":"highlight","target":"queue","at":{"word":"queued"}},{"do":"highlight","target":"cdn","at":{"word":"redirecting"}},{"do":"highlight","target":"warehouse","at":{"word":"reporting"}}],"why":"The full diagram emphasizes separate lookup and analytics paths rather than one shared write path."},{"id":"cached-or-direct","actions":[{"do":"camera","focus":"all","padding":0.08,"at":0},{"do":"highlight","target":"redis","at":{"word":"cached"}},{"do":"highlight","target":"queue","at":{"word":"queued"}},{"do":"highlight","target":"api","at":{"word":"simpler"}},{"do":"highlight","target":"warehouse","at":