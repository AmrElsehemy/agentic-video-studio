{"scenes":[{"id":"hook","actions":[{"do":"camera","focus":["client","app","cosmos"],"padding":0.15,"at":0},{"do":"reveal","target":"client","at":{"word":"Every"}},{"do":"reveal","target":"app","at":{"word":"read"}},{"do":"reveal","target":"cosmos","at":{"word":"database"}}],"why":"The client, application tier, and authoritative database appear as the costly read path is introduced."},{"id":"setup","actions":[{"do":"camera","focus":["vnet","subnet","app","pe-redis","redis","pe-cosmos","cosmos"],"padding":0.12,"at":0},{"do":"reveal","target":"vnet","at":{"word":"private"}},{"do":"reveal","target":"subnet","at":{"word":"network"}},{"do":"reveal","target":"pe-redis","at":{"word":"Redis"}},{"do":"reveal","target":"redis","at":{"after":"pe-redis","delay":0.1}},{"do":"reveal","target":"pe-cosmos","at":{"word":"Cosmos"}}],"why":"The private network and subnet are established around the app and its Redis and Cosmos endpoints."},{"id":"hit","actions":[{"do":"camera","focus":["client","app","pe-redis","redis"],"padding":0.15,"at":0},{"do":"flow","step":"r1","edges":["client-app"],"at":{"word":"Reads"}},{"do":"flow","step":"r2","edges":["read-cache"],"at":{"word":"cache"}},{"do":"flow","step":"r3","edges":["cache-hit"],"at":{"word":"hit"}}],"why":"A read travels to the cache first, and a cache hit immediately returns along the reverse path."},{"id":"miss","actions":[{"do":"camera","focus":["app","pe-cosmos","cosmos"],"padding":0.15,"at":0},{"do":"flow","step":"r4","edges":["read-db"],"at":{"word":"miss"}},{"do":"flow","step":"r5","edges":["db-return"],"at":{"word":"DB"}}],"why":"A cache miss sends the application to Cosmos DB and brings the authoritative value back."},{"id":"write","actions":[{"do":"camera","focus":["client","app","pe-cosmos","cosmos"],"padding":0.15,"at":0},{"do":"flow","step":"w1","edges":["client-app"],"at":{"word":"Writes"}},{"do":"flow","step":"w2","edges":["write-db"],"at":{"word":"Cosmos"}},{"do":"flow","step":"w3","edges":["commit"],"at":{"word":"commits"}}],"why":"Writes bypass Redis, go directly to Cosmos DB, and complete when Cosmos commits the change."},{"id":"feed","actions":[{"do":"camera","focus":["functions","pe-cosmos","cosmos"],"padding":0.15,"at":0},{"do":"reveal","target":"functions","at":{"word":"Function"}},{"do":"flow","step":"w4","edges":["change-feed"],"at":{"word":"feed"}}],"why":"The committed change is exposed through the change feed and picked up by the Azure Function."},{"id":"update","actions":[{"do":"camera","focus":["functions","pe-redis","redis"],"padding":0.15,"at":0},{"do":"flow","step":"w5","edges":["update-cache"],"at":{"word":"updates"}},{"do":"highlight","target":"redis","at":{"word":"Redis"}}],"why":"The function applies the change to Redis, keeping the cache current while the step also covers versioned tombstones."},{"id":"monitor","actions":[{"do":"camera","focus":"all","padding":0.08,"at":0},{"do":"reveal","target":"monitor","at":{"word":"Monitor"}},{"do":"reveal","target":"logs-label","at":{"word":"metrics"}},{"do":"connect","edge":"logs-subnet","at":{"after":"logs-label","delay":0.1}},{"do":"connect","edge":"logs-services","at":{"after":"logs-subnet","delay":0.1}},{"do":"connect","edge":"logs-cosmos","at":{"after":"logs-services","delay":0.1}}],"why":"Azure Monitor and the metrics-and-logs label appear as telemetry links all parts of the system to monitoring."},{"id":"verdict","actions":[{"do":"camera","focus":"all","padding":0.08,"at":0},{"do":"highlight","target":"redis","at":{"word":"Fast"}},{"do":"highlight","target":"cosmos","at":{"word":"correct"}},{"do":"highlight","target":"app","at":{"word":"build"}}],"why":"The completed architecture is summarized by fast cache reads, correct authoritative writes, and the application that coordinates them."}]}
