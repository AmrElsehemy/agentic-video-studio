  "storyPattern": "mechanic",
  "numberRelevant": true,
  "premise": "In Tromsø, Norway, the sun stays below the horizon from 28 November to 14 January, and a computed day-and-night map shows why.",
  "audiencePromise": "See why the sun never rises over one city.",
  "openLoop": "How can a city go 48 days without a sunrise?",
  "payoff": "In winter the city stays on the night side of the line between day and night; in summer the midnight sun stays up for 71 days.",
  "targetEmotion": "surprise",
  "engagementQuestion": "Could you live through 48 days without a sunrise?",
