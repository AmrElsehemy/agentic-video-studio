export type Quat = [number, number, number, number];
export type RotationRow = {plate: number; age: number; lat: number; lon: number; angle: number; fixed: number};
export type RotationModel = Map<number, {fixed: number; rows: {age: number; q: Quat}[]}[]>;
export type PlateTable = {ages: number[]; plates: Record<string, Quat[]>};
export declare const IDENTITY: Quat;
export declare const parseRotations: (text: string) => RotationRow[];
export declare const quatFromPole: (lat: number, lon: number, angle: number) => Quat;
export declare const quatMul: (a: Quat, b: Quat) => Quat;
export declare const quatInverse: (q: Quat) => Quat;
export declare const quatNormalize: (q: number[]) => Quat;
export declare const quatBlend: (a: Quat, b: Quat, share: number) => Quat;
export declare const rotatePoint: (q: Quat, point: [number, number]) => [number, number];
export declare const rotateGeometry: <G extends {type: string; coordinates: any}>(geometry: G, q: Quat) => G;
export declare const buildModel: (rows: RotationRow[]) => RotationModel;
export declare const relativeToFixed: (model: RotationModel, plate: number, age: number) => {fixed: number; q: Quat} | null;
export declare const absolute: (model: RotationModel, plate: number, age: number, depth?: number) => Quat;
export declare const sampleTable: (model: RotationModel, plates: number[], ages: number[]) => PlateTable;
export declare const tableRotation: (table: PlateTable, plate: number, age: number) => Quat | null;
export declare const reconstruction: (table: PlateTable, plate: number, fixed: number, age: number) => Quat | null;
