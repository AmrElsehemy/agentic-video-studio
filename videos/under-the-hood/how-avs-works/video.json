  "title": "How an AI Video Studio Works",
  "direction": {
    "engineVersion": 2,
    "storyPattern": "mechanic",
    "numberRelevant": false,
    "premise": "Agentic Video Studio turns one line into a finished short through a chain of agents and tools, and checks the result before it ships.",
    "audiencePromise": "See every stage of an AI video pipeline, from a one-line topic to a checked final video.",
    "openLoop": "How does one line become a finished video?",
    "payoff": "Planner, writer, storyboard, assets, a deterministic renderer and a QA critic: and this video came out of that renderer.",
    "targetEmotion": "curiosity",
    "engagementQuestion": "Which stage would you automate first?",
    "targetSecondsBetweenVisualChanges": 0.65
  },
