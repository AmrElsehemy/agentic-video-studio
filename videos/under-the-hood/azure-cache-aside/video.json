  "direction": {
    "engineVersion": 2,
    "storyPattern": "mechanic",
    "numberRelevant": false,
    "premise": "An Azure reference architecture reads through a Redis cache and keeps it fresh from the Cosmos DB change feed.",
    "audiencePromise": "Follow one read and one write through a real Azure architecture, step by numbered step.",
    "openLoop": "How does the cache stay correct when writes skip it?",
    "payoff": "The change feed triggers a Function that updates Redis or writes a versioned tombstone.",
    "targetEmotion": "curiosity",
    "engagementQuestion": "Would you build it this way?",
    "targetSecondsBetweenVisualChanges": 0.65
  },
