  "title": "The Country 15 Minutes Off Its Neighbour's Clock",
  "direction": {
    "engineVersion": 2,
    "storyPattern": "mechanic",
    "numberRelevant": true,
    "premise": "Nepal's clocks run at UTC+05:45, fifteen minutes ahead of India's UTC+05:30, a choice made in 1986.",
    "audiencePromise": "See why one country keeps a 45-minute time zone.",
    "openLoop": "Why does Nepal keep an odd clock?",
    "payoff": "Nepal used Kathmandu sun time until 1920, then India's time, then moved ahead 15 minutes in 1986; its meridian runs through Gaurishankar.",
    "targetEmotion": "surprise",
    "engagementQuestion": "Would you keep a clock set by a mountain?",
    "targetSecondsBetweenVisualChanges": 0.65
  },
